# Neon — https://console.neon.tech
# Encode special chars in password: @ → %40, # → %23
#
# App / serverless (pooled via PgBouncer — hostname includes -pooler):
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP]-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require"
#
# Migrations / seed / drizzle-kit — use the direct (non-pooler) URL from the Neon console:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP].[REGION].aws.neon.tech/[DB]?sslmode=require"

# Optional: postgres.js TLS — Neon hosts are auto-detected; set manually if needed
# DATABASE_SSL=require
# DATABASE_SSL=disable
