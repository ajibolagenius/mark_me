# Prefer Session pooler if direct DB host fails (IPv4). User: postgres.[PROJECT-REF]
# Encode special chars in password: @ → %40, # → %23
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Direct connection (IPv6 / compatible networks only)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
