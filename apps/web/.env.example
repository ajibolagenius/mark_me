# Database — Neon Postgres (required for Auth.js / tRPC that hits DB)
# Console: https://console.neon.tech — prefer the pooled (-pooler) URL for Next.js
# DATABASE_URL=postgresql://user:pass@localhost:5432/markme
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[EP]-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require
# Optional: force TLS for postgres.js (Neon hosts are auto-detected)
# DATABASE_SSL=require
# DATABASE_SSL=disable

# NextAuth / Auth.js — required in production. Generate: openssl rand -base64 32
# Leave unset (or omit these lines) in local dev to use the built-in dev fallback in auth.config.ts.
# Do not commit real secrets. Empty AUTH_SECRET= is treated as unset.
AUTH_SECRET=
NEXTAUTH_SECRET=

# App URL (production: your domain)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic links via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM="Mark Me <onboarding@yourdomain.com>"

# Upstash Redis (optional — add @upstash/redis + wire in API when caching/rate limits needed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic (Phase 7 — set to enable real AI; omit for graceful fallbacks)
# Generate an API key at console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the default Claude model
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Chrome Extension (Phase 8)
# Secret for signing extension tokens — must be ≥32 chars. Generate: openssl rand -base64 32
EXTENSION_TOKEN_SECRET=
