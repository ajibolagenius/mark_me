# Database — Neon Postgres (pooled -pooler URL for Next.js)
# Console: https://console.neon.tech
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[EP]-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require
# Optional: force TLS for postgres.js (Neon hosts are auto-detected)
# DATABASE_SSL=require
# DATABASE_SSL=disable

# Neon Auth (Managed Better Auth) — from `neon checkout` or Neon Console → Auth
NEON_AUTH_BASE_URL=https://[EP].neonauth.[REGION].aws.neon.tech/[DB]/auth
NEON_AUTH_JWKS_URL=https://[EP].neonauth.[REGION].aws.neon.tech/[DB]/auth/.well-known/jwks.json
# Session cookie signing secret (≥32 chars). Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# App URL
AUTH_URL=http://localhost:3000

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic (optional — omit for graceful AI fallbacks)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Chrome Extension — secret for signing extension tokens (≥32 chars)
EXTENSION_TOKEN_SECRET=
