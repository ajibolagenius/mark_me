# Database (required for OAuth, magic links, demo login that hits DB)
DATABASE_URL=postgresql://user:pass@localhost:5432/markme

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# App URL (production: your domain)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic links via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM="Mark Me <onboarding@yourdomain.com>"
