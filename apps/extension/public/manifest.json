{
  "manifest_version": 3,
  "name": "mark_me",
  "version": "1.1.0",
  "description": "Save and organize bookmarks with AI assistance. Quick-save from any page, search from a beautiful New Tab.",
  "author": "Ajibola Akelebe",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to mark_me",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "contextMenus", "alarms", "notifications"],
  "host_permissions": [
    "http://localhost/*",
    "https://*.vercel.app/*",
    "https://markme.live/*",
    "https://*.markme.live/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/extension-auth*",
        "https://*.vercel.app/extension-auth*",
        "https://markme.live/extension-auth*",
        "https://*.markme.live/extension-auth*"
      ],
      "js": ["content/auth-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://*.vercel.app/*",
      "https://markme.live/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
